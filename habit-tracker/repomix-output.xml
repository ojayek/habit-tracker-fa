/* ============================================================ Selectors */
function buildSelectors() {
  const yearSel = document.getElementById('year-select');
  const monthSel = document.getElementById('month-select');
  const cy = state.today.jy;
  yearSel.innerHTML = '';
  for (let y = cy - 2; y <= cy + 2; y++) {
    const o = document.createElement('option');
    o.value = y; o.textContent = String(y);
    yearSel.appendChild(o);
  }
  yearSel.value = state.year;
  monthSel.innerHTML = '';
  MONTHS.forEach((m, i) => {
    const o = document.createElement('option');
    o.value = i + 1; o.textContent = m;
    monthSel.appendChild(o);
  });
  monthSel.value = state.month;
  yearSel.onchange = () => { state.year = +yearSel.value; render(); };
  monthSel.onchange = () => { state.month = +monthSel.value; render(); };
}

const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) =>
  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

/* ============================================================ Info + Rate */
function renderInfoAndRate(totals) {
  const days = Jalali.jalaaliMonthLength(state.year, state.month);
  const start = Jalali.toGregorian(state.year, state.month, 1);
  const end = Jalali.toGregorian(state.year, state.month, days);

  document.getElementById('info-year').textContent = String(state.year);
  document.getElementById('info-month').textContent = MONTHS[state.month - 1];
  document.getElementById('info-start').textContent =
    `${start.gy}/${pad2(start.gm)}/${pad2(start.gd)}`;
  document.getElementById('info-end').textContent =
    `${end.gy}/${pad2(end.gm)}/${pad2(end.gd)}`;
  document.getElementById('info-days').textContent = String(days);

  const rate = totals.goal ? Math.min(1, totals.done / totals.goal) : 0;
  document.getElementById('rate-big').textContent = Math.round(rate * 100) + '%';

  const badge = document.getElementById('rate-badge');
  let text = '—', color = '#71717A';
  if (rate > 0.95) { text = '🏆 Excellent'; color = '#4ADE80'; }
  else if (rate > 0.8) { text = '❤️ Good Job'; color = '#A7F3D0'; }
  else if (rate > 0.5) { text = '✊ Do Better'; color = '#FCD34D'; }
  else if (rate > 0.3) { text = '👎 Low Effort'; color = '#FDBA74'; }
  else { text = '⚠️ Disaster'; color = '#FCA5A5'; }
  badge.textContent = text;
  badge.style.color = color;

  document.getElementById('footer-total').textContent = `${totals.done} / ${totals.goal}`;
}

/* ============================================================ Wave */
function buildSmoothPath(values, W, H, padTop, padBottom) {
  const n = values.length; if (!n) return '';
  const stepX = W / Math.max(1, n - 1);
  const pts = values.map((v, i) => [i * stepX, padTop + (1 - v) * (H - padTop - padBottom)]);
  let d = `M ${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x},${c1y} ${c2x},${c2y} ${p2[0]},${p2[1]}`;
  }
  return d;
}

function renderWave() {
  const svg = document.getElementById('wave-svg');
  const days = Jalali.jalaaliMonthLength(state.year, state.month);
  const key = monthKey(state.year, state.month);
  const rec = state.records[key] || {};
  const totalHabits = Math.max(1, state.habits.length);

  const values = [];
  for (let d = 1; d <= days; d++) {
    let done = 0;
    for (const h of state.habits) if ((rec[h.id] || []).includes(d)) done++;
    values.push(done / totalHabits);
  }

  const W = 1000, H = 190, padTop = 40, padBottom = 40;
  const path = buildSmoothPath(values, W, H, padTop, padBottom);
  const stepX = W / Math.max(1, days - 1);

  let markers = '';
  for (let i = 0; i < days; i++) {
    const v = values[i];
    const x = i * stepX;
    const y = padTop + (1 - v) * (H - padTop - padBottom);
    const label = v >= 0.999 ? '1' : v <= 0.001 ? '0' : '';
    const labelY = v >= 0.5 ? y - 12 : y + 20;
    if (label) {
      markers += `<text x="${x}" y="${labelY}" text-anchor="middle"
        font-family="'Times New Roman',serif" font-size="14" font-weight="700"
        fill="${v >= 0.5 ? '#A7F3D0' : '#71717A'}">${label}</text>`;
    }
  }

  const todayX = (state.today.jy === state.year && state.today.jm === state.month)
    ? (state.today.jd - 1) * stepX : -100;

  svg.innerHTML = `
    <defs>
      <linearGradient id="waveGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#10B981" stop-opacity=".35"/>
        <stop offset="100%" stop-color="#10B981" stop-opacity="0"/>
      </linearGradient>
      <filter id="waveGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>
    ${[0, 1, 2, 3, 4].map(i => {
    const y = padTop + (H - padTop - padBottom) * (i / 4);
    return `<line x1="0" y1="${y}" x2="${W}" y2="${y}"
        stroke="#27272A" stroke-width="1" stroke-dasharray="2 6" opacity=".5"/>`;
  }).join('')}
    ${todayX > 0 ? `<line x1="${todayX}" y1="8" x2="${todayX}" y2="${H - 8}"
      stroke="#8B5CF6" stroke-width="1" stroke-dasharray="4 4" opacity=".5"/>` : ''}
    <path d="${path} L ${W},${H} L 0,${H} Z" fill="url(#waveGrad)" opacity=".6"/>
    <path d="${path}" fill="none" stroke="#10B981" stroke-width="2.2"
      stroke-linecap="round" stroke-linejoin="round" filter="url(#waveGlow)"/>
    ${markers}
  `;
}

/* ============================================================ Donuts */
function drawDonut(svgEl, pct, color, valueLabel) {
  const r = 46, c = 2 * Math.PI * r;
  const clamped = Math.max(0, Math.min(1, pct));
  const dash = clamped * c;
  svgEl.innerHTML = `
    <circle cx="60" cy="60" r="${r}" fill="none" stroke="#27272A" stroke-width="10"/>
    <circle cx="60" cy="60" r="${r}" fill="none"
      stroke="${color}" stroke-width="10" stroke-linecap="round"
      stroke-dasharray="${dash} ${c}" transform="rotate(-90 60 60)"
      style="filter:drop-shadow(0 0 6px ${color}66); transition:stroke-dasharray .5s ease;"/>
    <text x="60" y="58" text-anchor="middle"
      font-family="'Times New Roman',serif" font-size="18" font-weight="700"
      fill="#FAFAFA" style="font-variant-numeric:tabular-nums">${valueLabel}</text>
    <text x="60" y="74" text-anchor="middle"
      font-family="'Libre Franklin',sans-serif" font-size="8"
      fill="#71717A" letter-spacing="1">PROGRESS</text>
  `;
}

function renderDonuts(totals) {
  const days = Jalali.jalaaliMonthLength(state.year, state.month);
  const key = monthKey(state.year, state.month);
  const rec = state.records[key] || {};
  const todayDay = (state.today.jy === state.year && state.today.jm === state.month)
    ? state.today.jd : days;

  const monthly = totals.goal ? Math.min(1, totals.done / totals.goal) : 0;
  const pace = totals.goal / Math.max(1, days);
  const actualPerDay = totals.done / Math.max(1, todayDay);
  const daysNorm = pace ? Math.min(1, actualPerDay / pace) : 0;

  const totalHabits = Math.max(1, state.habits.length);
  let last3sum = 0;
  for (let d = Math.max(1, todayDay - 2); d <= todayDay; d++) {
    let c = 0;
    for (const h of state.habits) if ((rec[h.id] || []).includes(d)) c++;
    last3sum += c / totalHabits;
  }
  const last3 = last3sum / Math.min(3, todayDay);

  drawDonut(document.querySelector('[data-id="donut-month"]'), monthly, '#EF4444',
    Math.round(monthly * 1000) / 10 + '%');
  drawDonut(document.querySelector('[data-id="donut-days"]'), daysNorm, '#0EA5E9',
    Math.round(daysNorm * 1000) / 10 + '%');
  drawDonut(document.querySelector('[data-id="donut-last"]'), last3, '#F59E0B',
    Math.round(last3 * 1000) / 10 + '%');
}

/* ============================================================ Table */
function renderTable() {
  const days = Jalali.jalaaliMonthLength(state.year, state.month);
  const key = monthKey(state.year, state.month);
  const rec = state.records[key] || {};
  const isCurrent = state.today.jy === state.year && state.today.jm === state.month;
  const todayDay = isCurrent ? state.today.jd : -1;

  const dh = document.getElementById('days-header');
  let html = '';
  for (let d = 1; d <= days; d++) {
    const dow = dowLetterForJalaliDay(state.year, state.month, d);
    const isToday = d === todayDay ? ' is-today' : '';
    html += `<div class="day-head${isToday}">
      <span class="num">${d}</span>
      <span class="dow">${dow}</span>
    </div>`;
  }
  dh.innerHTML = html;

  document.getElementById('panel-count').textContent = `(${state.habits.length})`;

  const list = document.getElementById('habit-list');
  if (!state.habits.length) {
    list.innerHTML = '';
    document.getElementById('empty-state').classList.remove('hidden');
    document.getElementById('table-wrap').classList.add('hidden');
    document.getElementById('habit-foot').innerHTML = '';
    return;
  }
  document.getElementById('empty-state').classList.add('hidden');
  document.getElementById('table-wrap').classList.remove('hidden');

  let rows = '';
  state.habits.forEach((h, idx) => {
    const color = colorFor(idx, h);
    const checks = new Set(rec[h.id] || []);
    const g = Math.max(1, Number(h.goal) || 1);
    const done = Math.min(checks.size, g);
    const progress = Math.min(1, checks.size / g);
    const collapsed = state.compactAll || state.collapsed.has(h.id);
    const initial = (h.name || '?').trim().charAt(0);

    rows += `<div class="habit-row${collapsed ? ' is-collapsed' : ''}"
                  data-id="${h.id}" style="--c:${color}">
      <div class="col-habit">
        <button class="habit-logo" data-action="toggle-collapse"
                title="${collapsed ? 'باز کردن' : 'جمع کردن'}">${escapeHtml(initial)}</button>
        <span class="habit-name" title="${escapeHtml(h.name)}">${escapeHtml(h.name)}</span>
        <span class="habit-actions">
          <button class="icon-btn" data-action="edit" title="ویرایش">✎</button>
          <button class="icon-btn danger" data-action="delete" title="حذف">✕</button>
        </span>
      </div>
      <div class="col-goal">${g}</div>
      <div class="col-days" dir="ltr">`;

    for (let d = 1; d <= days; d++) {
      const checked = checks.has(d) ? 'true' : 'false';
      const isToday = d === todayDay ? ' is-today' : '';
      rows += `<button class="day-cell${isToday}" role="checkbox"
        aria-checked="${checked}" data-habit="${h.id}" data-day="${d}"
        aria-label="${escapeHtml(h.name)}، روز ${d}"><span class="day-box"></span></button>`;
    }

    rows += `</div>
      <div class="col-progress">
        <div class="progress-bar">
          <div class="progress-fill${progress >= 1 ? ' is-full' : ''}"
               style="width:${(progress * 100).toFixed(1)}%"></div>
        </div>
        <span class="progress-text">${done}/${g}</span>
      </div>
    </div>`;
  });
  list.innerHTML = rows;

  const foot = document.getElementById('habit-foot');
  let f = `<div class="col-habit">تکمیل روز</div><div class="col-goal"></div>
           <div class="col-days" dir="ltr">`;
  for (let d = 1; d <= days; d++) {
    let count = 0;
    for (const h of state.habits) if ((rec[h.id] || []).includes(d)) count++;
    const isToday = d === todayDay ? ' is-today' : '';
    f += `<div class="day-cell${isToday}" data-count="${count}"><span class="day-box"></span></div>`;
  }
  f += `</div><div class="col-progress"></div>`;
  foot.innerHTML = f;
}

/* ============================================================ Totals */
function computeTotals() {
  const key = monthKey(state.year, state.month);
  const rec = state.records[key] || {};
  let done = 0, goal = 0;
  for (const h of state.habits) {
    const checks = rec[h.id] || [];
    const g = Math.max(1, Number(h.goal) || 1);
    goal += g;
    done += Math.min(checks.length, g);
  }
  return { done, goal };
}

/* ============================================================ Views */
function applyViews() {
  document.getElementById('date-box').style.display = state.views.date ? '' : 'none';
  document.getElementById('wave-box').style.display = state.views.wave ? '' : 'none';
  document.getElementById('rate-box').style.display = state.views.rate ? '' : 'none';
  document.getElementById('habits-panel').style.display = state.views.habits ? '' : 'none';
  document.getElementById('donuts').style.display = state.views.donuts ? '' : 'none';

  document.getElementById('panel-toggle')
    .setAttribute('aria-expanded', state.panelOpen ? 'true' : 'false');

  /* ✅ کلید تاریخ */
  document.body.classList.toggle('hide-date', state.hideDate);
  const tDate = document.getElementById('toggle-date');
  if (tDate) tDate.checked = !state.hideDate;

  /* ✅ کلید ستون عادت */
  document.body.classList.toggle('hide-habit-col', state.hideHabitCol);
  const tHabit = document.getElementById('toggle-habit-col');
  if (tHabit) tHabit.checked = !state.hideHabitCol;
}

function render() {
  const totals = computeTotals();
  renderInfoAndRate(totals);
  renderWave();
  renderTable();
  renderDonuts(totals);
  applyViews();
}

/* ============================================================ Modal */
function openModal(habit) {
  document.getElementById('modal-title').textContent = habit ? 'ویرایش عادت' : 'افزودن عادت';
  document.getElementById('habit-id').value = habit ? habit.id : '';
  document.getElementById('habit-name').value = habit ? habit.name : '';
  document.getElementById('habit-goal').value = habit ? habit.goal : 20;
  const m = document.getElementById('modal');
  m.classList.remove('hidden'); m.classList.add('flex');
  setTimeout(() => document.getElementById('habit-name').focus(), 0);
  state.editingId = habit ? habit.id : null;
}
function closeModal() {
  const m = document.getElementById('modal');
  m.classList.add('hidden'); m.classList.remove('flex');
  state.editingId = null;
}

/* ============================================================ Control panel */
const cmdPanel = document.getElementById('cmd-panel');
function openCmd() { cmdPanel.classList.add('is-open'); cmdPanel.setAttribute('aria-hidden', 'false'); }
function closeCmd() { cmdPanel.classList.remove('is-open'); cmdPanel.setAttribute('aria-hidden', 'true'); }
function toggleCmd() {
  cmdPanel.classList.contains('is-open') ? closeCmd() : openCmd();
}

/* ============================================================ Events */
document.addEventListener('click', async (e) => {
  const cell = e.target.closest('.day-cell');
  if (cell && cell.dataset.habit) {
    const habitId = cell.dataset.habit;
    const day = Number(cell.dataset.day);
    const key = monthKey(state.year, state.month);
    if (!state.records[key]) state.records[key] = {};
    if (!state.records[key][habitId]) state.records[key][habitId] = [];
    const arr = state.records[key][habitId];
    const idx = arr.indexOf(day);
    if (idx >= 0) arr.splice(idx, 1); else arr.push(day);
    render();
    api.toggle(key, habitId, day).catch(console.error);
    return;
  }

  const action = e.target.closest('[data-action]');
  if (action) {
    const id = action.closest('.habit-row')?.dataset.id;
    if (!id) return;
    const h = state.habits.find((x) => x.id === id);
    if (!h) return;
    if (action.dataset.action === 'toggle-collapse') {
      if (state.compactAll) { state.compactAll = false; state.collapsed.clear(); }
      else if (state.collapsed.has(id)) state.collapsed.delete(id);
      else state.collapsed.add(id);
      localStorage.setItem(LS.collapsed, JSON.stringify([...state.collapsed]));
      render(); return;
    }
    if (action.dataset.action === 'edit') { openModal(h); return; }
    if (action.dataset.action === 'delete') {
      if (confirm(`عادت «${h.name}» حذف بشه؟`)) {
        await api.deleteHabit(id);
        state.habits = state.habits.filter((x) => x.id !== id);
        state.collapsed.delete(id);
        localStorage.setItem(LS.collapsed, JSON.stringify([...state.collapsed]));
        render();
      }
      return;
    }
  }

  /* panel toggle (accordion) */
  if (e.target.closest('#panel-toggle')) {
    state.panelOpen = !state.panelOpen;
    localStorage.setItem(LS.panelOpen, state.panelOpen ? '1' : '0');
    applyViews();
    return;
  }

  /* add */
  if (e.target.closest('#add-habit') || e.target.closest('#add-first')) { openModal(null); return; }
  if (e.target.closest('#cancel')) closeModal();
  if (e.target.id === 'modal') closeModal();

  /* control panel */
  if (e.target.closest('#cmd-toggle')) { toggleCmd(); return; }
  if (e.target.closest('#cmd-close')) { closeCmd(); return; }
  if (cmdPanel.classList.contains('is-open')
    && !e.target.closest('#cmd-panel')
    && !e.target.closest('#cmd-toggle')) {
    closeCmd();
  }
});

document.getElementById('date-box-check').addEventListener('change', (e) => {
  state.dateHidden = !e.target.checked;
  localStorage.setItem(LS.dateHidden, state.dateHidden ? '1' : '0');
  applyViews();
});

document.querySelectorAll('[data-view]').forEach((el) => {
  el.addEventListener('change', () => {
    state.views[el.getAttribute('data-view')] = el.checked;
    localStorage.setItem(LS.views, JSON.stringify(state.views));
    applyViews();
  });
});

document.getElementById('cmd-compact-all').addEventListener('change', (e) => {
  state.compactAll = e.target.checked;
  render();
});

document.getElementById('cmd-no-orbit').addEventListener('change', (e) => {
  document.body.classList.toggle('no-orbit', e.target.checked);
});

document.getElementById('cmd-mouse-glow').addEventListener('change', (e) => {
  document.body.classList.toggle('no-mouse', !e.target.checked);
});

document.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault(); toggleCmd(); return;
  }
  if (e.key === 'Escape') {
    if (!document.getElementById('modal').classList.contains('hidden')) closeModal();
    else if (cmdPanel.classList.contains('is-open')) closeCmd();
  }
});

document.addEventListener('mousemove', (e) => {
  const r = document.documentElement;
  r.style.setProperty('--mx', e.clientX + 'px');
  r.style.setProperty('--my', e.clientY + 'px');
});

document.getElementById('habit-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const name = document.getElementById('habit-name').value.trim();
  const goal = Number(document.getElementById('habit-goal').value);
  if (!name) return;
  const id = document.getElementById('habit-id').value;
  if (id) {
    await api.updateHabit(id, name, goal);
    const h = state.habits.find((x) => x.id === id);
    if (h) { h.name = name; h.goal = goal; }
  } else {
    const res = await api.addHabit(name, goal);
    if (res && res.habit) state.habits.push(res.habit);
  }
  closeModal();
  render();
});
/* ---------- کلید تاریخ ---------- */
document.getElementById('toggle-date').addEventListener('change', (e) => {
  state.hideDate = !e.target.checked;
  localStorage.setItem('habit.hideDate', state.hideDate ? '1' : '0');
  applyViews();
});

/* ---------- کلید ستون عادت ---------- */
document.getElementById('toggle-habit-col').addEventListener('change', (e) => {
  state.hideHabitCol = !e.target.checked;
  localStorage.setItem('habit.hideHabitCol', state.hideHabitCol ? '1' : '0');
  applyViews();
});
/* ============================================================ Init */
(async function init() {
  await loadIcons();
  applyIcons();

  const now = new Date();
  const j = Jalali.toJalaali(now.getFullYear(), now.getMonth() + 1, now.getDate());
  state.today = j;
  state.year = j.jy;
  state.month = j.jm;

  const data = await api.getData();
  state.habits = data.habits || [];
  state.records = data.records || {};

  buildSelectors();
  render();
})().catch((err) => {
  console.error(err);
  document.body.innerHTML =
    `<div style="padding:32px;direction:rtl;color:#fca5a5;font-family:Vazirmatn">
       خطا در بارگذاری: ${err.message}
     </div>`;
});
</file>

