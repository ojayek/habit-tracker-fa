  collapsed: 'habit.collapsed',
  panelOpen: 'habit.panelOpen',
  dateHidden: 'habit.dateHidden',
  views: 'habit.views',
};
const state = {
  year: 1403, month: 7,
  habits: [], records: {},
  today: null, editingId: null,
  collapsed: new Set(JSON.parse(localStorage.getItem(LS.collapsed) || '[]')),
  compactAll: false,
  panelOpen: localStorage.getItem(LS.panelOpen) !== '0',
  dateHidden: localStorage.getItem(LS.dateHidden) === '1',
  hideDate: localStorage.getItem('habit.hideDate') === '1',
