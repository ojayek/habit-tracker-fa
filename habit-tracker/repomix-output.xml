<file path="README.md">
# ردیاب عادت ماهانه (شمسی)

## اجرا

```bash
npm install
npm start
```

سپس در مرورگر باز کن: http://localhost:3000

## اجرا با احراز هویت (توصیه می‌شود برای سرور عمومی)

```bash
AUTH_USER=me AUTH_PASS=mysecret npm start
```

## دیپلوی روی سرور

### Linux + pm2
```bash
npm i -g pm2
pm2 start server.js --name habit --update-env
pm2 save && pm2 startup
```

### Docker (اختیاری)
```dockerfile
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
EXPOSE 3000
CMD ["node", "server.js"]
```

### Render / Railway / Fly.io
فقط مخزن را وصل کن، دستور شروع `npm start`، متغیر `PORT` خودکار ست می‌شود.

## داده‌ها

همه چیز در فایل `data.json` کنار سرور ذخیره می‌شود. برای بکاپ، همین فایل را کپی کن.

ساختار:
```json
{
  "habits": [{ "id": "h...", "name": "ورزش صبح", "goal": 20 }],
  "records": { "1403-07": { "h...": [1, 3, 5] } }
}
```
</file>

<file path="server.js">
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const serve = require('koa-static');
const path = require('path');
const fs = require('fs');
/* ---------- thesvg — بارگذاری آیکون‌ها (اختیاری) ---------- */
let ICONS = {};
try {
  const mod = require('thesvg');
  const candidates = [mod.icons, mod.default, mod];
  for (const c of candidates) {
    if (c && typeof c === 'object') {
      for (const k of Object.keys(c)) {
        if (typeof c[k] === 'string' && c[k].includes('<svg')) ICONS[k] = c[k];
      }
    }
  }
  console.log(`🎨 thesvg: ${Object.keys(ICONS).length} آیکون لود شد`);
} catch (e) {
  console.warn('⚠️  thesvg در دسترس نیست، از fallback داخلی استفاده می‌شود');
}
const app = new Koa();
const router = new Router();
const DATA_FILE = path.join(__dirname, 'data.json');

/* ---------- ذخیره‌سازی روی فایل JSON ---------- */
function loadData() {
  if (!fs.existsSync(DATA_FILE)) {
    const initial = { habits: [], records: {} };
    fs.writeFileSync(DATA_FILE, JSON.stringify(initial, null, 2), 'utf8');
    return initial;
  }
  try {
    return JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
  } catch {
    return { habits: [], records: {} };
  }
}
function saveData(data) {
  fs.writeFileSync(DATA_FILE, JSON.stringify(data, null, 2), 'utf8');
}

/* ---------- Auth ساده (اختیاری) ---------- */
if (process.env.AUTH_USER && process.env.AUTH_PASS) {
  app.use(async (ctx, next) => {
    const h = ctx.headers.authorization;
    const fail = () => {
      ctx.status = 401;
      ctx.set('WWW-Authenticate', 'Basic realm="Habit Tracker"');
      ctx.body = 'Auth required';
    };
    if (!h || !h.startsWith('Basic ')) return fail();
    const [u, p] = Buffer.from(h.slice(6), 'base64').toString().split(':');
    if (u !== process.env.AUTH_USER || p !== process.env.AUTH_PASS) return fail();
    await next();
  });
}

/* ---------- API ---------- */
router.get('/api/data', (ctx) => {
  ctx.body = loadData();
});

router.post('/api/habits', (ctx) => {
  const data = loadData();
  const { name, goal } = ctx.request.body || {};
  if (!name) { ctx.status = 400; ctx.body = { error: 'name required' }; return; }
  const habit = {
    id: 'h' + Date.now().toString(36),
    name: String(name).trim(),
    goal: Math.max(1, Math.min(31, Number(goal) || 1))
  };
  data.habits.push(habit);
  saveData(data);
  ctx.body = { ok: true, habit };
});

router.put('/api/habits/:id', (ctx) => {
  const data = loadData();
  const h = data.habits.find((x) => x.id === ctx.params.id);
  if (!h) { ctx.status = 404; return; }
  const { name, goal } = ctx.request.body || {};
  if (name !== undefined) h.name = String(name).trim();
  if (goal !== undefined) h.goal = Math.max(1, Math.min(31, Number(goal) || 1));
  saveData(data);
  ctx.body = { ok: true, habit: h };
});

router.delete('/api/habits/:id', (ctx) => {
  const data = loadData();
  const id = ctx.params.id;
  data.habits = data.habits.filter((x) => x.id !== id);
  for (const key of Object.keys(data.records)) delete data.records[key][id];
  saveData(data);
  ctx.body = { ok: true };
});

router.post('/api/toggle', (ctx) => {
  const { monthKey, habitId, day } = ctx.request.body || {};
  if (!monthKey || !habitId || !day) { ctx.status = 400; return; }
  const data = loadData();
  if (!data.records[monthKey]) data.records[monthKey] = {};
  if (!data.records[monthKey][habitId]) data.records[monthKey][habitId] = [];
  const arr = data.records[monthKey][habitId];
  const idx = arr.indexOf(day);
  if (idx >= 0) arr.splice(idx, 1); else arr.push(day);
  arr.sort((a, b) => a - b);
  saveData(data);
  ctx.body = { ok: true, checks: arr };
});
router.get('/api/icons', (ctx) => { ctx.body = ICONS; });
app.use(bodyParser());
app.use(serve(path.join(__dirname, 'public')));
app.use(router.routes()).use(router.allowedMethods());

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`✅ http://localhost:${PORT}`));
